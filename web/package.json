{
  "name": "nova-web",
  "private": true,
  "workspaces": ["packages/*", "apps/*"],
  "scripts": {
    "dev": "npm run dev -w apps/app",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "typescript": "5.6.3",
    "@types/react": "19.0.1",
    "@types/react-dom": "19.0.1",
    "@types/node": "22.10.1"
  }
}
