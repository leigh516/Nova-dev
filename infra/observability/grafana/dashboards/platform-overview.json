    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 4,
    "w": 4,
    "x": 8,
    "y": 0
   },
   "targets": [
    {
     "refId": "A",
     "expr": "max(service:http_errors:ratio5m)",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "#2BB673",
        "value": null
       },
       {
        "color": "#E8A33D",
        "value": 0.01
       },
       {
        "color": "#E8505B",
        "value": 0.05
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "background",
    "graphMode": "area",
    "textMode": "auto"
   }
  },
  {
