 ],
 "templating": {
  "list": [
   {
    "name": "service",
    "label": "서비스",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "query": "label_values(nova_http_requests_total, service)",
    "includeAll": true,
    "multi": true,
    "current": {
     "text": "All",
     "value": "$__all"
    },
    "refresh": 2
   }
  ]
 },
 "annotations": {
  "list": []
 }
}
