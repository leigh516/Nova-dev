  {
   "id": 11,
   "type": "table",
   "title": "느린 라우트 Top (p95)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 24,
    "x": 0,
    "y": 21
   },
   "targets": [
    {
     "refId": "A",
     "expr": "topk(10, histogram_quantile(0.95, sum by (service, route, le) (rate(nova_http_request_duration_seconds_bucket[5m]))))",
     "format": "table",
     "instant": true,
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "transformations": [
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true
      }
     }
    }
   ]
  },
  {
   "id": 12,
   "type": "row",
   "title": "자원",
   "collapsed": false,
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 29
