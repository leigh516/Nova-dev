# 이 파일을 .env 로 복사해 값을 채운다. .env 는 git 에 올리지 않는다.
# 실행 환경: dev | prod  (prod 에서는 기본 비밀키·개발 기능이 켜져 있으면 기동 거부)
NOVA_ENV=dev
# JWT 서명 키 (prod 는 32자 이상 필수)
JWT_SECRET=change-me-dev-secret
# Kafka 가 있으면 주소. 비우면 프로세스 내 메모리 버스 사용
KAFKA_BOOTSTRAP=
# 서비스별 DB (비우면 data/<서비스>.db SQLite). local_db_setup.py 가 아래 블록을 채운다
# DATABASE_URL_SAMPLE=mysql+pymysql://user:pass@127.0.0.1:3306/nova_sample
# 로컬 MariaDB 설정 스크립트용 root 비밀번호 (스크립트 실행 시에만 환경변수로 넘긴다)
# NOVA_DB_ROOT_PASSWORD=
# 웹 앱이 호출할 게이트웨이 주소
NEXT_PUBLIC_API_BASE=http://localhost:8080/v1
